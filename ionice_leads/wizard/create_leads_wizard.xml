<odoo>
    <record id="view_create_leads_wizard_form" model="ir.ui.view">
        <field name="name">create.leads.wizard.form</field>
        <field name="model">create.leads.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Leads">
                <group>
                    <field name="partner_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Crear Leads" type="object" name="action_create_leads" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

